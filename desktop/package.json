{
  "name": "@webobsidian/desktop",
  "version": "0.3.0",
  "private": true,
  "description": "Local-first WebObsidian desktop app with an embedded vault service",
  "author": "xnohat <xnohat@gmail.com>",
  "homepage": "https://github.com/xnohat/webobsidian",
  "license": "MIT",
  "main": "dist/main.js",
  "desktopName": "webobsidian.desktop",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "smoke:local": "node scripts/smoke-local-first.mjs",
    "start": "electron dist/main.js",
    "dev": "node scripts/build.mjs && electron dist/main.js",
    "dist": "node scripts/build.mjs && electron-builder",
    "dist:dir": "node scripts/build.mjs && electron-builder --dir",
    "dist:publish": "node scripts/build.mjs && electron-builder --publish always"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "build": {
    "appId": "com.xnohat.webobsidian",
    "productName": "WebObsidian",
    "executableName": "webobsidian",
    "copyright": "Copyright © 2026 xnohat",
    "electronVersion": "43.2.0",
    "directories": {
      "output": "release",
      "buildResources": "buildResources"
    },
    "files": ["dist/**/*"],
    "extraResources": [
      { "from": ".gen/server", "to": "server" }
    ],
    "asar": true,
    "electronLanguages": ["en-US"],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "buildResources/icon.png",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ],
      "darkModeSupport": true,
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "icon": "buildResources/icon.png",
      "target": [
        { "target": "nsis", "arch": ["x64", "arm64", "ia32"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "icon": "buildResources/icon.png",
      "category": "Office",
      "maintainer": "xnohat <xnohat@gmail.com>",
      "syncDesktopName": true,
      "target": [
        { "target": "AppImage", "arch": ["x64", "arm64"] },
        { "target": "deb", "arch": ["x64", "arm64"] }
      ],
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    },
    "publish": [
      { "provider": "github", "owner": "xnohat", "repo": "webobsidian" }
    ]
  }
}
